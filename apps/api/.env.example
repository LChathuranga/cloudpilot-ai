# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://cloudpilot:change-me@localhost:5432/cloudpilot?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# In development, requests may use x-user-id for local testing only.
# In production, set AUTH_MODE=jwt and a strong JWT_SECRET (32+ random bytes).
AUTH_MODE=development
JWT_SECRET="replace-with-a-long-random-secret-before-production"
